{
  // Type-checks the test suite against the library's own types.
  //
  // The main `tsconfig.json` excludes `tests/` (it drives the build, and the
  // build must not emit test files). That left the suite unchecked: hand-built
  // `BirthChart` fixtures silently drifted from the interface, and adding a
  // required field to it surfaced only as ~65 runtime failures rather than a
  // compile error pointing at each fixture.
  //
  // `npm run typecheck` runs both configs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The base config pins `rootDir` to `src` so the build emits a flat `dist`.
    // Nothing is emitted here, and `tests/` sits outside `src`, so widen it.
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  // `exclude` must be restated. It is inherited from the base config, where it
  // lists `tests`, and `exclude` filters `include` — so extending without this
  // line produced a config that named `tests` in `include` and then removed it
  // again, type-checking only `src` while reporting success. Found in Phase
  // 38.7, when a breaking result-shape change produced zero test errors.
  "exclude": ["node_modules", "dist"],
  "include": ["src", "tests"]
}
